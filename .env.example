# Копирайте като .env.local и попълнете стойностите.
# NEXT_PUBLIC_* стойностите са публични (стигат до браузъра). Останалите — само сървър.

# Публичен адрес на сайта (за линкове в имейли и Stripe redirect-и)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) — етап 2 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Тайна! Supabase → Project Settings → API Keys → Secret key (sb_secret_…).
# Само за сървъра (Stripe webhook, плащания). Никога с префикс NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers → API keys; започнете с тестовия sk_test_…) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ID-тата на цените — генерират се с: npm run stripe:setup
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_TRIAL_FEE=
STRIPE_PORTAL_CONFIG=

# Stripe Managed Payments (merchant of record): true след одобрение в Stripe → Settings → Managed Payments
STRIPE_MANAGED_PAYMENTS=false
# Задължително съгласие с условията в Checkout (изисква Terms URL в Stripe → Settings → Public details)
STRIPE_TOS_CONSENT=false
